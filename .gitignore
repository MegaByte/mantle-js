/docs/internal/

# Generated TypeScript declarations (npm run gen:types)
types/

# Visual-smoke output galleries (written by test/*VisualSmoke.mjs and
# friends for human inspection; assertions are in-memory — never goldens)
test/visuals/
test/font/visuals/

# Third-party test fixtures — fetched by scripts/fetchTestFixtures.mjs
test/font/fixtures/
# ...and a SYMLINK to them: `dir/` matches only a directory, so a linked fixtures dir would show as untracked, and
# committing it would replace every checkout's fetched fixtures with a link.
test/font/fixtures
examples/tiger.svg
# Optional local SVGs for tests. Not committed.
/examples/local/
# Tiger outline crops generated by probes/morphScale/_mkAssets.mjs. Not committed.
probes/morphScale/assets/tiger*.svg

# Proprietary benchmark artwork — local only, never tracked
/examples/_bench/
/examples/_bench

# Probe captures and generated benchmark reports
/probes/*Out/
/probes/_broken90/
/probes/_balanceBench*.json
/probes/_balanceBench*Report*.md
# The morph coverage model's cached exact reference (tens of MB, regenerated on demand).
/probes/morphScale/_morphCovRef.json
# probes/analyticArea: the evidence archives and raw result JSON (hundreds of MB of generated output, like the other
# probes' *Out/ folders). They are regenerated by the probes, or fetched from the last commit that tracked them
# (see probes/analyticArea/README.md). The verifier scripts, patches and *.verified.json receipts stay tracked.
/probes/analyticArea/results/*
!/probes/analyticArea/results/*.py
!/probes/analyticArea/results/*.patch
!/probes/analyticArea/results/*.verified.json

# Copied from the repository root by scripts/prepack.mjs so the tarball carries it
PROVENANCE.md

# Dependencies are hoisted to the repository root; never commit a node_modules link
node_modules
