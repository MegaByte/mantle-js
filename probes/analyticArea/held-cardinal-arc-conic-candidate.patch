+    if (hi > lo) {
+      vec2 u=a+lo*d, v=a+hi*d, mid=a+0.5*(lo+hi)*d;
+      float cr=u.x*v.y-u.y*v.x;
+      sum += dot(mid,mid) <= 1.0 ? cr : atan(cr,dot(u,v));
+    }
+    lo=hi;
+  }
+  return 0.5*sum;
+}
